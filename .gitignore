# Whitelist: only the port's own sources, tools and documentation are tracked. Never the game (disc image, APK,
# extracted data, shader containers), builds (NRO, ELF, SDK outputs), logs, captures or console dumps.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/portlog.md
!/docs/
!/renderer/

!/nx/
/nx/*
!/nx/sdretail/
!/nx/shaders/
!/nx/tools/
!/nx/desktop/
/nx/desktop/*
!/nx/desktop/CMakeLists.txt
!/nx/desktop/*.toml

!/port/
/port/*
!/port/tools/
/port/tools/*
!/port/tools/shaderlib/
!/port/tools/aba_scan.py
!/port/tools/apply_branding.py
!/port/tools/build_bench.ps1
!/port/tools/check_text_roundtrip.py
!/port/tools/compile_internal_hlsl.sh
!/port/tools/compile_internal_ps.sh
!/port/tools/compile_internal_vs.sh
!/port/tools/debug_composite.py
!/port/tools/debug_composite_run.ps1
!/port/tools/export_renderer.ps1
!/port/tools/extract_iso.py
!/port/tools/fps_bench.ps1
!/port/tools/fps_menu_patch.py
!/port/tools/keys_continue.txt
!/port/tools/make_internal_ps.py
!/port/tools/make_internal_vs.py
!/port/tools/make_switch_buttons.py
!/port/tools/native_shot.ps1
!/port/tools/prof_symbolize.py
!/port/tools/sdbig.py
!/port/tools/sdcontainer.py
!/port/tools/sdshaders.py
!/port/tools/sdtex.py
!/port/tools/sdtext.py
!/port/tools/seam.py
!/port/tools/seam_bands.py
!/port/tools/xtex.py
!/port/shaders/
/port/shaders/*
!/port/shaders/internal/
/port/shaders/internal/*
!/port/shaders/internal/*.hlsl

__pycache__/
*.pyc
*.log
*.spv
*.nro
*.elf
